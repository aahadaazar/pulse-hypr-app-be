{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/verify.sh\" changed",
            "timeout": 600,
            "async": true,
            "statusMessage": "Verifying changed components"
          }
        ]
      }
    ]
  }
}
